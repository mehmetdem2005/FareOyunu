duration_ms: 15000
buffers { size_kb: 32768 fill_policy: RING_BUFFER }
data_sources { config {
  name: "track_event"
  track_event_config { disabled_categories: "*" enabled_categories: "godot" }
} }
data_sources { config {
  name: "linux.ftrace"
  ftrace_config {
    ftrace_events: "sched/sched_switch"
    ftrace_events: "sched/sched_waking"
    ftrace_events: "power/cpu_frequency"
  }
} }
data_sources { config {
  name: "android.log"
  android_log_config { log_ids: LID_MAIN filter_tags: "godot" }
} }
