  "masks": {
    "source_immutable": true,
    "derived_max_size_px": 1024,
    "sequence": [
      "M0 immutable original JPEG + SHA",
      "M1 provisional island/sea segmentation (preview cutoff is NOT coastline authority)",
      "M2 relative elevation map",
      "M3 slope after real unit scale approval",
      "M4 curvature/concavity",
      "M5 manual-approved cliff vs beach shoreline",
      "M6 verified river/lake masks or BLOCKED",
      "M7 distance-to-water and wetness proxy after water verification",
      "M8 habitat and manual path/tree-base annotations",
      "M9 deterministic macro/mid masks with separate overrides",
      "M10 weight normalization and material cap",
      "M11 per-mask hash/LOD edge test and 1K derived mask export"
    ],
    "note": "Water is not reliably inferable from black JPEG pixels alone; visual source cannot imply physical bathymetry."
  },
  "anti_tiling": {
    "levels": [
      "macro map-driven zone breaks",
      "mid local material blend",
      "micro normal/roughness"
    ],
    "uv": "physical size from vendor, world space for gentle slope, selective triplanar on steep slopes if mobile-tested",
    "variants": [
      "deterministic region rotation",
      "bounded per-patch scale variance",
      "small material substitution at ecologically justified locations"
    ],
    "deterministic_seed_for_masks_only": 719031,
    "provisional_max_blended_layers_per_fragment": 3,
    "realism": "10cm mouse needs true object/mesh microrelief later; normal maps alone do not alter geometry/collision",
    "no_single_material_carpet": true,
    "no_fixed_width_beach_ring": true
  },
  "render": {
    "after_each_part": true,
    "engine_output_only": true,
    "renderer": "Godot 4.7.2 Mobile",
    "island_id": "island_se_01",
    "format": "PNG",
    "resolution_px": [
      1536,
      1536
    ],
    "camera": "fixed orthographic top-down; centered on SE bounding box, 10 percent margin; no tilt/yaw",
    "lock": [
      "camera position/projection/frame",
      "key light",
      "exposure/tonemap",
      "background",
      "rendering resolution"
    ],
    "output_template": "artifacts/reviews/pine_se/part_<NN>_overhead.png",
    "metadata_template": "artifacts/reviews/pine_se/part_<NN>_metrics.json",
    "evidence": [
      "commit SHA",
      "source SHA",
      "material and mask hashes",
      "Godot version",
      "camera/light profile hash",
      "renderer and hardware",
      "perf p50/p95/p99 or not measured",
      "human review"
    ],
    "prohibited": "Do not label an image as real Godot render if it was generated with Python/AI or a different engine."
  },
