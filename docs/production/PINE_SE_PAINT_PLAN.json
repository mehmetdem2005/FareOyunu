    "resolution_policy": "Poly Haven source textures exact 1k only; original source JPEG resolution unchanged",
    "required": [
      "diffuse",
      "nor_gl"
    ],
    "optional": [
      "rough",
      "ao",
      "displacement",
      "arm"
    ],
    "albedo_color_space": "sRGB",
    "data_maps_color_space": "linear",
    "normal_convention": "OpenGL GL",
    "metallic_constant": 0,
    "roughness_policy": "constant for matt dry soils; optional 1k maps for materially different wet/moss/rock",
    "ao_policy": "only after no-double-darkening and GPU budget proof",
    "arm_orm_policy": "optional packed replacement; avoid loading redundant separate maps",
    "displacement_policy": "preserve 1k maps as reference only, no runtime ground/collision displacement without separate approval",
