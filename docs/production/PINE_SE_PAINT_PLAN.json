  "status": "planning_only",
  "base_branch": "fix/terrain-direct-source-no-reconstruction",
  "branch": "docs/se-pine-biome-paint-plan",
  "one_part_per_approval": true,
  "target": {
    "island_id": "island_se_01",
    "biome": "dangerous_pine_forest",
    "mouse_body_length_m": 0.1,
    "engine": "Godot 4.7.2 stable",
    "renderer": "Mobile",
    "allowed_island_ids": [
      "island_se_01"
    ],
    "unchanged_island_ids": [
      "island_nw_01",
      "island_sw_01",
      "island_north_01"
    ],
    "source": {
      "path": "assets/terrain/heightmaps/island_se_01_original.jpg",
      "original_codec": "JPEG",
      "original_sha256": "12e0868d2ab57f5d7840747a31222fbb5b6561f1d00e94103ed0834d7c781691",
      "dimensions": [
        1536,
        1536
      ],
      "scene": "scenes/terrain/island_se_01.tscn",
      "definition": "data/terrain/island_se_01.tres",
      "preview_mesh": "assets/terrain/preview_meshes/island_se_01_preview.glb",
      "vertical_scale": "display_units_not_authoritative_metres",
      "rule": "NEVER generate, draw, smooth, erode, rewrite, or fake precision of source heightmap"
    }
  },
  "restrictions": {
    "plan_only_no_download_or_paint": true,
    "material_resolution_px": 1024,
    "forbid_2k": true,
    "prohibit": [
      "editing other three islands",
      "source terrain heightmap changes",
      "chunk/LOD logic",
      "network/authority/physics logic",
      "water or vegetation gameplay",
      "scene-embedded big data"
    ],
    "paint_layer_state_is_client_visual_only": true,
    "source_of_truth": "this JSON and linked production contracts",
    "changes_require_version_and_user_approval": true
  },
  "directories": {
    "create_now": [
      "docs/production/PINE_SE_PAINT_PLAN.json",
      "docs/production/PINE_SE_PART0_CHECKLIST.md",
      "docs/production/PINE_SE_PAINT_PLAN.schema.json"
    ],
    "plan_for_later": [
      "assets/materials/polyhaven/1k/<asset_id>/<map>.*",
      "data/biomes/pine_se/material_catalog.json",
      "data/biomes/pine_se/paint_rules.json",
      "data/biomes/pine_se/masks/<derived_mask>.png",
      "data/biomes/pine_se/render_profile.tres",
      "materials/terrain/pine_se/<external_resource>.tres",
      "tools/paint/pine_se/<script>",
      "tests/paint/pine_se/<test>",
      "artifacts/reviews/pine_se/part_<NN>_overhead.png",
      "artifacts/reviews/pine_se/part_<NN>_metrics.json"
    ],
    "rules": [
      "Only external resources in .tscn",
      "snake_case folder and names",
      "Never overwrite uploaded source",
      "Per-asset URL, hash, licence and physical size"
    ]
  },
